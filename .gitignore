# Python
services/**/.venv
**/__pycache__/
*.pyc
*.egg-info/

# Env
.env

# 本地运行时 blob 存储（上传缓存，不入库）
blobs/

# 内网部署：模型文件与真实 env（含密码）不提交
deploy/intranet/models/
deploy/intranet/.env.infra
deploy/intranet/.env.app

# Frontend
web/node_modules/
web/dist/

# OS
.DS_Store

# SDD workspace
.superpowers/sdd/

# 备份文件
*.bak
*.backup-*
.env.backup-*
dify-env.backup-*

# Agent 运行时生成产物
output/
.claude/

# DeerFlow 运行时数据（checkpoints/memory）
services/deerflow/data/
services/deerflow/backend/data/

# kb-api 运行时数据（同步下载等）
services/kb-api/data/

# Dify：仅跟踪 docker 部署配置与补丁，忽略上游源码与 volumes 数据
dify/*
!dify/docker
dify/docker/*
!dify/docker/docker-compose.yaml
!dify/docker/docker-compose.middleware.yaml
!dify/docker/pull-images.sh
!dify/docker/patches
dify/docker/patches/*
!dify/docker/patches/README.md
!dify/docker/patches/*.py

# 凭据文件（含真实密码，严禁提交）
CREDENTIALS.md

# RAGFlow 源码参考（仅作接口契约参考，不导入、不提交）
ragflow/

# 临时文件
.tmp/

# 临时调试文件
.tmp_*

# VitePress generated site / cache
web/public/api-guide/
web/api-guide/.vitepress/cache/
