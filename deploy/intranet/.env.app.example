# 应用服务环境变量（容器内，经 env_file 注入）
# 部署前替换密码占位符（与 .env.infra 保持一致）；LLM/MinerU 可在「模型配置」页运行时配置
DATABASE_URL=postgresql+asyncpg://dev:CHANGE_ME_POSTGRES_PASSWORD@kge-postgres:5432/dev_db
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@kge-redis:6379/0
ES_HOST=http://kge-elasticsearch:9200
MINIO_ENDPOINT=kge-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_ROOT_PASSWORD
KKFV_URL=http://kge-kkfileview:8012
KB_API_INTERNAL_URL=http://kb-api:8000
JWT_SECRET=CHANGE_ME_JWT_SECRET
KB_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN
DEERFLOW_SERVICE_URL=http://deerflow:2027
# 模型全部外接（不本地部署 BGE-M3/reranker，容器不挂载模型文件）：
# 向量模型走 OpenAI 兼容 /embeddings；重排走 /rerank（留空则检索跳过重排）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=
# 文档解析：本地 MinerU 引擎未部署，置空强制走云 API（在「模型配置」页填 MINERU_API_KEY）
MINERU_LOCAL_URL=
MINERU_API_KEY=
# 文档库解析引擎地址：留空 → 云端 SaaS（复用 MINERU_API_KEY）；非空 → 本地 mineru-kit V1（如 http://127.0.0.1:8010）
STRUCTURED_KIT_BASE_URL=
# LLM（运行时可在「模型配置」页配置并持久化到 DB；此处为默认兜底）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
# Dify 未部署，留空；智能问答的 Dify 检索后续指向任一可达 Dify 端点即可启用
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_DATASET_IDS=
