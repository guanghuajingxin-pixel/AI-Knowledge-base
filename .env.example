DATABASE_URL=postgresql+asyncpg://dev:dev123456@127.0.0.1:5432/dev_db
REDIS_URL=redis://:dev123456@127.0.0.1:6379/0
ES_HOST=http://127.0.0.1:9200
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
KKFV_URL=http://127.0.0.1:8012
JWT_SECRET=kb-mvp-dev-secret
# 文档解析：本地 MinerU 引擎（scripts/start-mineru.sh，默认 127.0.0.1:2028）。
# 留空/删除则仅在配置了 MINERU_API_KEY 时走 MinerU 云 API；office 文档另有 python-pptx/docx 即时解析兜底。
MINERU_LOCAL_URL=http://127.0.0.1:2028
# MinerU 云 API Key（本地引擎未运行时的降级通道，可留空）
MINERU_API_KEY=
# 文档库解析引擎地址：留空 → 云端 SaaS（复用 MINERU_API_KEY）；非空 → 本地 mineru-kit V1。
# 代码默认 http://127.0.0.1:8010（本地自建 kit）；未部署本地 kit 时务必置空以走云，否则解析报连接失败。
STRUCTURED_KIT_BASE_URL=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
# 向量模型（外接，OpenAI 兼容 /embeddings）：本地 RAG 检索/入库使用。
# 未配置时本地 RAG 不可用（Dify/RAGFlow 检索不受影响）；维度须与既有 ES 索引一致（EMBED_DIM=1024）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBED_DIM=1024
# 重排模型（外接 /rerank，Jina/SiliconFlow 风格）；留空时检索跳过重排（RRF/BM25 排序兜底）
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=
# Dify 知识库（智能问答 Agent 使用；Service API 端点需含端口与 /v1）
# 只配「连接」；具体检索/同步哪些库到「知识源管理」登记（source_type=dify_dataset）
DIFY_BASE_URL=http://127.0.0.1:8088/v1
DIFY_API_KEY=
# 已废弃：默认数据集列表改由知识源注册表承载，保留仅为兼容旧部署（可留空）
DIFY_DATASET_IDS=
# RAGFlow 知识库（第二个外部检索引擎，与 Dify 并列；端点需含 /api/v1）
# 同样只配「连接」；库在「知识源管理」以 source_type=ragflow_dataset 登记
RAGFLOW_BASE_URL=http://127.0.0.1:9380/api/v1
RAGFLOW_API_KEY=
# 智能问答 DWS 兜底（留空时从服务进程 PATH 查找新版 dws）
DWS_BIN=
# 显式绑定平台用户 UUID 到 dws profile；不填写时仅超级管理员可用当前组织账号
QA_DWS_USER_PROFILES={}
# 治理标准页使用的钉钉 AI 多维表。留空时使用内置《杰克知识管理规范》；
# 部署到其他租户或替换规范表时，填写目标多维表 URL 中的 baseId / sheetId。
DINGTALK_STANDARDS_BASE_ID=
DINGTALK_STANDARDS_SHEET_ID=
# 知识加工「钉钉知识」列表快照：全量遍历只在手动点「刷新」时执行，
# 结果持久化在 PostgreSQL（dingtalk_file_snapshots 表），进程重启后列表仍可用。
# KGE_DINGTALK_SNAPSHOT 仅用于升级时导入历史磁盘快照（一次性，导入后不再使用）。
KGE_DINGTALK_SNAPSHOT=/tmp/kge_dingtalk_files.json

# 目录同步：整任务硬超时、单次导出超时、索引等待上限（秒）
# 硬超时与索引等待默认 7 天（604800）：大库/慢解析（RAGFlow DeepDoc/OCR）不应被分钟级上限截断
SYNC_RUN_TIMEOUT_SECONDS=604800
SYNC_EXPORT_TIMEOUT_SECONDS=360
SYNC_INDEXING_TIMEOUT_SECONDS=604800
# 等待索引成功后再记为同步成功
SYNC_DIFY_WAIT_INDEXING=true

# 与 Dify 的 UPLOAD_FILE_SIZE_LIMIT 保持一致（MB），原文件不做有损转换
DIFY_UPLOAD_MAX_MB=15
